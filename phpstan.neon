includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max

    paths:
        - app
        - src
        - tests
        - database
        - config

    # No baseline. A baseline is a list of problems nobody will ever fix.
    # If something cannot pass, it gets an ADR, not an ignore line.

    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    treatPhpDocTypesAsCertain: false

    reportUnmatchedIgnoredErrors: true

    excludePaths:
        analyse:
            - bootstrap/cache
            - storage
            # Pest's architecture DSL is fluent and resolved at runtime, so
            # every `expect(...)->not->toUse(...)` chain reads as a call on
            # mixed. The rules in these files are themselves a static analysis
            # gate and are exercised by the test suite; analysing them adds
            # noise and catches nothing. This is a scope decision, not a
            # baseline: no error in application code is suppressed anywhere.
            - tests/Architecture/LayeringTest.php

    ignoreErrors:
        # Eloquent model properties are resolved by Larastan, but dynamic
        # scopes on query builders still need help in a few generated spots.
        # Each entry added here must carry a comment explaining why.
