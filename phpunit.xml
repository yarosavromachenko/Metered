<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnRisky="true"
         failOnWarning="true"
         failOnNotice="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
    <testsuites>
        <!-- Pure domain logic. No database, no Redis, no framework. Milliseconds. -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>

        <!-- HTTP contracts, validation, problem+json, admin screens (Livewire). -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>

        <!-- Real PostgreSQL and Redis: repositories, outbox relay, stream consumer. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>

        <!-- Real parallel connections via spatie/fork. Never wrapped in a transaction. -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>

        <!-- Boots with APP_DEMO=true: self-service sign-up and its limits. -->
        <testsuite name="Demo">
            <directory>tests/Demo</directory>
        </testsuite>

        <!-- Pest Arch: layer and module boundaries, banned helpers, no float money. -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>

    <!--
        The coverage gate measures src/, where every business rule lives.

        app/ is deliberately absent. The architecture rules push all logic into
        modules, so app/ holds only framework glue — service providers and the
        console kernel — which is exercised by feature tests but is not the code
        a coverage number should be defending. If app/ ever grows something
        worth testing, that something is in the wrong directory.
    -->
    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <!-- Dev-only module, excluded from the production image too. -->
            <directory>src/Simulation</directory>
        </exclude>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_DEMO" value="false"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="OTEL_SDK_DISABLED" value="true"/>
        <!-- force="true" matters: without it, PHPUnit leaves an existing
             environment variable alone, and the container defines DB_CONNECTION
             already. The suite would then run against the development database,
             migrating and truncating it on every run. It did, until this was
             found by a test printing the database it was connected to.

             pgsql_testing also goes straight to PostgreSQL rather than through
             PgBouncer: transaction pooling hands a backend to whoever asks
             next, and a concurrency test that cannot hold its own session
             proves nothing. -->
        <env name="DB_CONNECTION" value="pgsql_testing" force="true"/>
        <env name="OUTBOX_CONNECTION" value="pgsql_testing" force="true"/>
        <env name="USAGE_CONNECTION" value="pgsql_testing" force="true"/>
    </php>
</phpunit>
