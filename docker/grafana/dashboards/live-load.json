{
  "uid": "metered-live",
  "title": "Metered \u2014 live load",
  "tags": [
    "metered"
  ],
  "timezone": "utc",
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events accepted, last minute",
      "description": "Events with an occurred_at in the last minute that have been stored \u2014 what sim:traffic sends, once the consumer has written it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "metered-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "metered-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS events FROM usage_events WHERE occurred_at > now() - interval '1 minute' AND received_at > now() - interval '1 minute'"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Oldest unpublished outbox message",
      "description": "Age, not count: a backlog that drains in seconds is healthy; three rows stuck for a minute are not.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "metered-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "metered-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COALESCE(EXTRACT(EPOCH FROM now() - min(occurred_at)), 0) AS age FROM outbox_messages WHERE published_at IS NULL"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Webhook deliveries waiting",
      "description": "Pending deliveries, including those waiting out a retry or an open circuit breaker.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "metered-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "metered-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS pending FROM webhook_deliveries WHERE status = 'pending'"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Invoices finalized, all time",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "metered-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "metered-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS invoices FROM invoices WHERE finalized_at IS NOT NULL"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Usage events per minute",
      "description": "By the minute the event happened. Late events (sent up to three days after the fact) land in their own minute, not now.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "metered-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "metered-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('minute', occurred_at) AS time, count(*) AS events FROM usage_events WHERE $__timeFilter(occurred_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rejected events per minute, by reason",
      "description": "A spike here is a client integration breaking.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "metered-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "metered-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('minute', rejected_at) AS time, reason AS metric, count(*) AS value FROM usage_event_rejections WHERE $__timeFilter(rejected_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Webhook attempts per minute, by outcome",
      "description": "Every attempt against the demo receiver, whose /flaky and /down endpoints fail on purpose.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "metered-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "metered-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('minute', attempted_at) AS time, CASE WHEN status_code BETWEEN 200 AND 299 THEN 'delivered' WHEN status_code IS NULL THEN 'no response' ELSE status_code::text END AS metric, count(*) AS value FROM webhook_attempts WHERE $__timeFilter(attempted_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox messages published per minute",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "metered-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "metered-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('minute', published_at) AS time, count(*) AS published FROM outbox_messages WHERE $__timeFilter(published_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Invoices finalized per day",
      "description": "Widen the time range to the last 90 days to see the seeded history closing month by month.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "metered-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "metered-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', finalized_at) AS time, currency AS metric, count(*) AS value FROM invoices WHERE finalized_at IS NOT NULL AND $__timeFilter(finalized_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ]
    }
  ],
  "description": "What make demo's traffic generator is doing to the system, read from PostgreSQL. Stream lag and latency percentiles, from Prometheus, are on the Ingestion dashboard."
}
