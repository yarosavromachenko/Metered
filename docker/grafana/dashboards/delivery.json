{
  "uid": "metered-delivery",
  "title": "Metered — Delivery",
  "description": "From a committed state change to a tenant's receiver: outbox lag, queue depths, and every webhook attempt by outcome and endpoint.",
  "tags": [
    "metered",
    "m8"
  ],
  "timezone": "utc",
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Outbox lag",
      "description": "Age of the oldest message the relay still has to publish. Seconds are healthy; minutes mean the relay is behind or stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "max(outbox_unpublished_age_seconds)",
          "instant": true
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Webhook success, 15 min",
      "description": "Share of attempts delivered, across endpoints.",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "sum(rate(webhook_deliveries_total{outcome=\"delivered\"}[15m])) / sum(rate(webhook_deliveries_total[15m]))",
          "instant": true
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Open breakers",
      "description": "Endpoints whose circuit breaker is holding deliveries back.",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "sum(webhook_breaker_open) or vector(0)",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Jobs waiting",
      "description": "Jobs on every queue the workers serve.",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "sum(queue_depth)",
          "instant": true
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Outbox lag",
      "description": "Oldest unpublished message, in seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "max(outbox_unpublished_age_seconds)",
          "legendFormat": "lag",
          "range": true
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Queue depth, by queue",
      "description": "billing: period closes; webhooks: delivery attempts; default: integration events.",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "max by (queue) (queue_depth)",
          "legendFormat": "{{queue}}",
          "range": true
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Webhook attempts per second, by outcome",
      "description": "delivered; retry (5xx, timeout, refused connection); given_up (after the last retry); refused (the SSRF guard would not call it).",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "sum by (outcome) (rate(webhook_deliveries_total[1m]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Success rate, by endpoint",
      "description": "Delivered attempts over all attempts, per endpoint id.",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "sum by (endpoint) (rate(webhook_deliveries_total{outcome=\"delivered\"}[5m])) / sum by (endpoint) (rate(webhook_deliveries_total[5m]))",
          "legendFormat": "{{endpoint}}",
          "range": true
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Receiver latency p95, by endpoint",
      "description": "How long each receiver takes to answer. The sender gives up after 10 seconds, and the histogram has no boundary between 10 and 30, so an endpoint that times out reads anywhere in that band: read it as a timeout, not as a latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(webhook_delivery_duration_seconds_bucket[5m])))",
          "legendFormat": "{{endpoint}}",
          "range": true
        }
      ],
      "id": 9
    },
    {
      "type": "table",
      "title": "Open breakers, by endpoint",
      "description": "Endpoints whose breaker is open or half-open now.",
      "datasource": {
        "type": "prometheus",
        "uid": "metered-prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "metered-prometheus"
          },
          "expr": "max by (endpoint) (webhook_breaker_open) == 1",
          "instant": true,
          "format": "table"
        }
      ],
      "id": 10,
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "endpoint": "Endpoint"
            }
          }
        }
      ]
    }
  ]
}
