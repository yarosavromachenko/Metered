APP_NAME=Metered
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Host ports for docker compose. Change these if something else on the machine
# already listens there; nothing inside the network cares.
APP_PORT=8080
POSTGRES_PORT=55432
PGBOUNCER_PORT=56432
REDIS_PORT_HOST=56379
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# The containers that mount the source tree run as this user, so files they
# create belong to you rather than to root. Change if your ids are not 1000.
DOCKER_UID=1000
DOCKER_GID=1000

# Opens self-service tenant sign-up in the admin panel and enables demo limits.
# The application refuses to boot with APP_DEMO=true outside local and demo
# environments — see docs/adr/0016-demo-mode-and-seed-profiles.md.
APP_DEMO=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The application connects through PgBouncer; the long-running daemons
# (usage:consume, outbox:relay, scheduler) use DB_DIRECT_* to bypass it,
# because transaction pooling breaks the session features they rely on.
DB_CONNECTION=pgsql
DB_HOST=pgbouncer
DB_PORT=6432
DB_DATABASE=metered
DB_USERNAME=metered
DB_PASSWORD=secret

DB_DIRECT_HOST=postgres
DB_DIRECT_PORT=5432

# The test suite has its own database and reaches PostgreSQL directly, so a
# test run can never touch the development data or depend on the pooler.
TEST_DB_HOST=postgres
TEST_DB_PORT=5432
TEST_DB_DATABASE=metered_testing

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Ingestion stream
USAGE_STREAM_KEY=usage:events
USAGE_STREAM_GROUP=usage-writers
USAGE_STREAM_BATCH_SIZE=500
USAGE_STREAM_MAXLEN=1000000
# Backpressure: above this pending count the ingestion endpoint answers 503.
USAGE_STREAM_BACKPRESSURE_PENDING=250000

# Acceptance window for usage events. The deduplication TTL must match the past
# window exactly — a shorter TTL opens a gap in the guarantee (ADR-0002).
USAGE_ACCEPT_PAST_DAYS=7
USAGE_ACCEPT_FUTURE_MINUTES=5
USAGE_DEDUP_TTL_SECONDS=604800

# Billing
BILLING_GRACE_MINUTES=60

# Webhooks
WEBHOOK_TIMEOUT_CONNECT=5
WEBHOOK_TIMEOUT_TOTAL=10
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_BREAKER_THRESHOLD=5
WEBHOOK_BREAKER_COOLDOWN_MINUTES=15

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

HORIZON_PREFIX=metered_horizon:

OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=metered
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Mail goes to Mailpit, which catches everything and shows it at
# http://localhost:8025. Nothing ever leaves the machine.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@metered.local
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
