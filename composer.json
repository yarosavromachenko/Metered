{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "metered/metered",
    "type": "project",
    "description": "Usage-based billing platform: metering, pricing, invoicing, double-entry ledger and signed webhooks.",
    "keywords": [
        "billing",
        "metering",
        "usage-based",
        "laravel",
        "ddd"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "brick/math": "^0.14",
        "brick/money": "^0.11",
        "filament/filament": "^4.0",
        "guzzlehttp/guzzle": "^7.11",
        "laravel/framework": "^13.15",
        "laravel/horizon": "^5.47",
        "laravel/octane": "^2.17",
        "laravel/tinker": "^3.0",
        "nyholm/psr7": "^1.8",
        "open-telemetry/api": "^1.9",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.14",
        "open-telemetry/sem-conv": "^1.38",
        "psr/clock": "^1.0",
        "ramsey/uuid": "^4.9",
        "symfony/clock": "^7.3 || ^8.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.6",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.4",
        "spatie/fork": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "Metered\\": "src/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/rector process --dry-run"
        ],
        "static": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G",
            "@php vendor/bin/deptrac analyse --config-file=deptrac.layers.yaml",
            "@php vendor/bin/deptrac analyse --config-file=deptrac.modules.yaml"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
